<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workerRowContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/workerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/workerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:singleLine="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/workerPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?attr/colorSecondary"
            android:textStyle="bold"
            android:singleLine="true"
            android:minWidth="32dp"
            android:gravity="end" />

        <TextView
            android:id="@+id/workerTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:singleLine="true"
            android:paddingStart="8dp"
            android:gravity="end"
            android:text="00:00:00" />

        <!-- Задача K (2026-11-05) — ▶ «Продолжить» of a stopped (failed /
             blocked / interrupted) row: same size and style as ■; sends a NEW
             explicit command (never automatic). -->
        <ImageButton
            android:id="@+id/workerContinueButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/task_continue"
            android:tint="@color/cinema_accent"
            android:visibility="gone" />

        <!-- Stop button — active rows: ■ «Остановить» (popup); stopped rows:
             ■ «Снять» (cancel-worker by task_id, the row disappears) -->
        <ImageButton
            android:id="@+id/workerStopButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_stop"
            android:contentDescription="@string/worker_stop_desc"
            android:tint="@color/cinema_error"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/workerProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:trackThickness="4dp"
        app:trackCornerRadius="2dp"
        app:indicatorColor="?attr/colorSecondary"
        app:trackColor="?attr/colorSurfaceVariant" />

    <!-- GPU retry policy — retry-pause countdown for retrying (active) rows -->
    <TextView
        android:id="@+id/workerRetryNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="?attr/colorSecondary"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- GPU retry policy — failed rows: the failed-scene caption (scope != current_scene);
         retrying rows: the reason of the last error under the countdown -->

    <TextView
        android:id="@+id/workerCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>
